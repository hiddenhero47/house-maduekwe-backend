# Copy this to .env.test and fill in real values before running `npm test`.
# .env.test is preferred over .env so tests never touch your dev/prod DB —
# see tests/setup/env.js.

# MUST be a replica set (not a standalone mongod) — checkout/order/shipment
# code runs multi-document transactions. A free Atlas cluster works.
# Use a dedicated database (e.g. .../house-maduekwe-test) — tests wipe every
# collection between runs.
TEST_MONGO_URI=

# Same secrets your real .env uses — tests sign/verify real tokens with these.
JWT_SECRET=test-jwt-secret
JWT_EMAIL_SECRET=test-jwt-email-secret
CHECKOUT_JWT_SECRET=test-checkout-jwt-secret

# Not exercised by the test suite (Stripe is deliberately not tested here —
# see the note in tests/README.md), but config/stripe.js constructs a Stripe
# client at require-time, so this just needs to be a non-empty string.
STRIPE_SECRET_KEY=sk_test_placeholder

# mailgun.js throws at require-time if this is empty (not just when actually
# sending), and app.js pulls in emailSender.js for every test file whether
# or not that test sends email — so this just needs to be a non-empty string.
MAILGUN_API_KEY=test-placeholder
MAILGUN_DOMAIN=test.example.com

FRONTEND_URL=http://localhost:5173
